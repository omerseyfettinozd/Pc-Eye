{
  "id": "ext-dynamic-controls",
  "scene": "web_url",
  "url": "https://the-internet.herokuapp.com/dynamic_controls",
  "page": "https://the-internet.herokuapp.com/dynamic_controls",
  "tags": [
    "browser",
    "ext"
  ],
  "prompt": "Firefox'ta açık {url} sayfasında: Remove düğmesine bas; işlem bitince sayfada çıkan ileti nedir?",
  "probe": [],
  "check": {
    "type": "answer",
    "expect": "It's gone!"
  },
  "probe_bridge": [
    {
      "args": [
        "browser",
        "click",
        "--name",
        "Remove"
      ]
    },
    {
      "args": [
        "browser",
        "wait",
        "--text",
        "It's gone!",
        "--timeout-ms",
        "10000"
      ],
      "expect_contains": [
        "\"matched\": true"
      ]
    }
  ]
}
