{
  "id": "ext-hover",
  "scene": "web_url",
  "url": "https://the-internet.herokuapp.com/hovers",
  "page": "https://the-internet.herokuapp.com/hovers",
  "tags": [
    "browser",
    "ext"
  ],
  "prompt": "Firefox'ta açık {url} sayfasında: İkinci kullanıcı resminin üzerine gel. Resmin altında görünen ad satırı nedir?",
  "probe": [],
  "check": {
    "type": "answer",
    "expect": [
      "name: user2",
      "user2"
    ]
  },
  "probe_bridge": [
    {
      "args": [
        "browser",
        "snapshot"
      ],
      "expect_contains": [
        "img \\\"User Avatar"
      ],
      "expect_absent": [
        "user2"
      ]
    },
    {
      "args": [
        "browser",
        "hover",
        "--ref",
        ".figure:nth-of-type(2) img"
      ],
      "expect_contains": [
        "name: user2"
      ]
    }
  ]
}
