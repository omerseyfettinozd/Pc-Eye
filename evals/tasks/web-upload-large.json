{
  "id": "web-upload-large",
  "scene": "web_hard",
  "tags": [
    "browser",
    "bridge",
    "web-hard"
  ],
  "prompt": "Firefox'ta açık \"{title}\" sayfasındaki \"Belge\" alanına {big_path} dosyasını yükle.",
  "probe": [],
  "check": {
    "type": "out_json",
    "expect": {
      "upload": "{big_name}",
      "size": "{big_size}"
    }
  },
  "probe_bridge": [
    {
      "args": [
        "browser",
        "upload",
        "--name",
        "Belge",
        "--path",
        "{big_path}"
      ],
      "expect_contains": [
        "{big_name}"
      ],
      "max_ms": 4000
    },
    {
      "args": [
        "browser",
        "wait",
        "--text",
        "Yüklendi: {big_name}",
        "--timeout-ms",
        "5000"
      ],
      "expect_contains": [
        "\"matched\": true"
      ]
    }
  ]
}
