{
  "id": "ext-dynamic-loading",
  "scene": "web_url",
  "url": "https://the-internet.herokuapp.com/dynamic_loading/2",
  "page": "https://the-internet.herokuapp.com/dynamic_loading/2",
  "tags": [
    "browser",
    "ext"
  ],
  "prompt": "Firefox'ta açık {url} sayfasında: Start düğmesine bas; yükleme bitince sayfada çıkan metin nedir?",
  "probe": [],
  "check": {
    "type": "answer",
    "expect": "Hello World!"
  },
  "probe_bridge": [
    {
      "args": [
        "browser",
        "click",
        "--name",
        "Start"
      ]
    },
    {
      "args": [
        "browser",
        "wait",
        "--text",
        "Hello World!",
        "--timeout-ms",
        "10000"
      ],
      "expect_contains": [
        "\"matched\": true"
      ]
    }
  ]
}
