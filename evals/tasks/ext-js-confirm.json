{
  "id": "ext-js-confirm",
  "scene": "web_url",
  "url": "https://the-internet.herokuapp.com/javascript_alerts",
  "page": "https://the-internet.herokuapp.com/javascript_alerts",
  "tags": [
    "browser",
    "ext"
  ],
  "prompt": "Firefox'ta açık {url} sayfasında: \"Click for JS Confirm\" düğmesine bas ve çıkan onay sorusunu KABUL et. Result satırında ne yazıyor?",
  "probe": [],
  "check": {
    "type": "answer",
    "expect": [
      "You clicked: Ok",
      "Result: You clicked: Ok"
    ]
  },
  "probe_bridge": [
    {
      "args": [
        "browser",
        "click",
        "--name",
        "Click for JS Confirm",
        "--args",
        "{\"dialog\": \"accept\"}"
      ],
      "expect_contains": [
        "I am a JS Confirm",
        "-> true",
        "You clicked: Ok"
      ]
    }
  ]
}
