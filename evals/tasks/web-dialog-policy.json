{
  "id": "web-dialog-policy",
  "scene": "web_hard",
  "tags": [
    "browser",
    "bridge",
    "web-hard"
  ],
  "prompt": "Firefox'ta açık \"{title}\" sayfasında \"Kaydı sil\" düğmesine bas; çıkan onay sorusunu REDDET. Sayfadaki durum ne yazıyor?",
  "probe": [],
  "check": {
    "type": "out_json",
    "expect": {
      "confirm": false
    }
  },
  "probe_bridge": [
    {
      "args": [
        "browser",
        "click",
        "--name",
        "Kaydı sil"
      ],
      "expect_contains": [
        "Kayıt silinsin mi?",
        "-> false"
      ],
      "max_ms": 1500
    },
    {
      "args": [
        "browser",
        "click",
        "--name",
        "Kaydı sil",
        "--args",
        "{\"dialog\": \"accept\"}"
      ],
      "expect_contains": [
        "-> true"
      ]
    },
    {
      "args": [
        "browser",
        "wait",
        "--text",
        "Silindi",
        "--timeout-ms",
        "3000"
      ],
      "expect_contains": [
        "\"matched\": true"
      ]
    },
    {
      "args": [
        "browser",
        "click",
        "--name",
        "Kod sor",
        "--args",
        "{\"dialog_text\": \"4821\"}"
      ],
      "expect_contains": [
        "Kod?",
        "4821"
      ]
    },
    {
      "args": [
        "browser",
        "dialogs"
      ],
      "expect_contains": [
        "\"accept\": false"
      ]
    },
    {
      "args": [
        "browser",
        "click",
        "--name",
        "Kaydı sil"
      ],
      "expect_contains": [
        "-> false"
      ]
    },
    {
      "args": [
        "browser",
        "wait",
        "--text",
        "Vazgeçildi",
        "--timeout-ms",
        "3000"
      ],
      "expect_contains": [
        "\"matched\": true"
      ]
    }
  ]
}
