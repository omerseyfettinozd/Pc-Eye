{
  "id": "run-gtk-form",
  "scene": "form",
  "tags": [
    "tool:run"
  ],
  "probe": [
    {
      "args": [
        "run",
        "{\"window\": \"{title}\", \"steps\": [{\"set\": \"Ad Soyad\", \"text\": \"{name}\"}, {\"click\": \"Bültene abone ol\"}, {\"select\": \"{default_city}\", \"option\": \"{city}\"}, {\"click\": \"Gönder\", \"expect\": \"Kaydedildi\"}]}"
      ],
      "expect_contains": [
        "\"ok\": true",
        "\"completed\": 4"
      ],
      "timeout": 60
    }
  ],
  "check": {
    "type": "out_json",
    "expect": {
      "name": "{name}",
      "newsletter": true,
      "city": "{city}"
    }
  }
}
