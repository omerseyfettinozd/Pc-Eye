{
  "id": "ext-table",
  "scene": "web_url",
  "url": "https://the-internet.herokuapp.com/tables",
  "page": "https://the-internet.herokuapp.com/tables",
  "tags": [
    "browser",
    "ext"
  ],
  "prompt": "Firefox'ta açık {url} sayfasında: Example 1 tablosunda soyadı (Last Name) Conway olan kişinin Due değeri nedir?",
  "probe": [],
  "check": {
    "type": "answer",
    "expect": "$50.00"
  },
  "probe_bridge": [
    {
      "args": [
        "browser",
        "snapshot",
        "--query",
        "Conway"
      ],
      "expect_contains": [
        "Due: $50.00"
      ],
      "max_ms": 400
    }
  ]
}
