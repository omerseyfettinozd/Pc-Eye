{
  "id": "terminal-read",
  "scene": "terminal",
  "tags": [
    "perception:terminal",
    "tool:snapshot"
  ],
  "prompt": "\"{title}\" başlıklı terminalde bir dağıtım anahtarı yazdırıldı. Anahtar nedir?",
  "probe": [
    {
      "args": [
        "snapshot",
        "--window",
        "{title}"
      ],
      "expect_contains": [
        "{token}"
      ]
    },
    {
      "args": [
        "ui",
        "--window",
        "{window}"
      ],
      "expect_contains": [
        "{token}"
      ]
    }
  ],
  "check": {
    "type": "answer",
    "expect": "{token}"
  }
}
